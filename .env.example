# Copy to .env for local overrides. Replace every example value before deployment.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
JWT_EXPIRES_IN=12h
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
DATABASE_SSL=false
DATABASE_URL=postgres://laundry:laundry@postgres:5432/laundry_map
REDIS_URL=redis://:laundry-map-local-cache-password@redis:6379
POSTGRES_USER=laundry
POSTGRES_PASSWORD=laundry
REDIS_PASSWORD=laundry-map-local-cache-password
PAYSTACK_SECRET_KEY=replace-with-a-test-paystack-secret
FLUTTERWAVE_SECRET_KEY=replace-with-a-test-flutterwave-secret
FLUTTERWAVE_SECRET_HASH=replace-with-a-test-flutterwave-webhook-hash
TRUST_PROXY=loopback
SOCKET_IO_TRANSPORTS=websocket,polling
